# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Mister Focus Contact & Lead Delivery Settings:
# OWNER_EMAIL: The owner's email address where validated customer inquiries should be delivered.
OWNER_EMAIL=""

# Email Service Provider Configuration (Optional - for live email delivery):
# Provide either SMTP settings or API key for SendGrid / Resend:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SENDGRID_API_KEY=""
RESEND_API_KEY=""

# WhatsApp International Phone Number (Optional):
# Only activate when international country code is confirmed by the owner (e.g., "+91" or relevant country prefix + "0543291056").
# If left blank, the interface displays direct telephone calling to avoid improper international routing.
VITE_WHATSAPP_PHONE=""
